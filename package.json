{
  "name": "octivity",
  "version": "0.1.0",
  "description": "Compare the activity of multiple GitHub repositories on a single timeline chart. No server, no install.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": [
    "github",
    "activity",
    "commits",
    "chart",
    "visualization",
    "repository",
    "comparison"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
